ry-black"},{"name":"Tấm nền","value":"oled"},{"name":"Cấu hình","value":"ai-9-hx370-64gb-2tb"}],"price":0,"sku":null,"image":""},{"name":"","attributes":[{"name":"MÀU","value":"retro-power"},{"name":"Tấm nền","value":"oled"},{"name":"Cấu hình","value":"ai-9-hx370-64gb-4tb"}],"price":0,"sku":null,"image":""}],"specs":{},"warranty":"","html":"<h2><strong>Giới thiệu về Máy tính cầm tay AYANEO 3 (R7 8840U/AI 9 HX370)</strong></h2>\n<p><strong>Máy tính cầm tay AYANEO 3 (phiên bản R7 8840U và AI 9 HX370)</strong> là siêu phẩm mới nhất trong dòng handheld PC cao cấp, mang đến sức mạnh vượt trội trong một thiết kế nhỏ gọn. Cùng <strong><a href=\"/\">Pcngon</a></strong> khám phá chi tiết những điểm nổi bật khiến AYANEO 3 trở thành lựa chọn hàng đầu cho game thủ hiện đại!</p>\n<h3><strong>Màn hình OLED cao cấp, hiển thị sống động</strong></h3>\n<p>AYANEO 3 sở hữu màn hình OLED 7 inch độ phân giải Full HD (1920×1080), tần số quét 144Hz, độ sáng tối đa lên đến 800 nits và dải màu rộng 150% sRGB, 110% DCI-P3. Hình ảnh hiển thị cực kỳ sắc nét, rực rỡ và mượt mà, mang đến cảm giác chân thực khi chơi game hoặc xem phim. Người dùng cũng có thể tùy chọn phiên bản LCD 120Hz cho hiệu năng ổn định hơn, đáp ứng nhu cầu đa dạng về trải nghiệm hiển thị.</p>\n<figure class=\"wp-caption aligncenter\" id=\"attachment_36363\"><img alt=\"Máy Tính Cầm Tay Ayaneo 3 (r7 8840u, Ai 9 Hx370) 6\" class=\"size-full wp-image-36363\" height=\"782\" src=\"https://pcngon.vn/wp-content/uploads/2025/10/May-tinh-cam-tay-AYANEO-3-R7-8840U-AI-9-HX370-6-1.jpg\" width=\"1000\"/><figcaption class=\"wp-caption-text\" id=\"caption-attachment-36363\">Máy Tính Cầm Tay Ayaneo 3 (r7 8840u, Ai 9 Hx370) 6</figcaption></figure>\n<h3><strong>Hiệu năng mạnh mẽ với CPU AMD Ryzen và GPU Radeon tích hợp</strong></h3>\n<p><strong><a href=\"/danh-muc/may-tinh-cam-tay\">Máy tính cầm tay</a></strong> này được trang bị tùy chọn vi xử lý AMD Ryzen 7 8840U hoặc Ryzen AI 9 HX370, mang lại hiệu năng xử lý mạnh mẽ cho cả chơi game, đồ họa và ứng dụng AI. Phiên bản HX370 sở hữu GPU Radeon 890M tích hợp, cho phép chạy mượt các tựa game AAA ở mức thiết lập cao. Kết hợp cùng bộ nhớ RAM LPDDR5X tốc độ 7500 MT/s và ổ SSD PCIe 4.0, AYANEO 3 đáp ứng hoàn hảo cả tác vụ giải trí lẫn công việc sáng tạo chuyên sâu.</p>\n<figure class=\"wp-caption aligncenter\" id=\"attachment_36364\"><img alt=\"Máy Tính Cầm Tay Ayaneo 3 (r7 8840u, Ai 9 Hx370) 5\" class=\"size-full wp-image-36364\" height=\"667\" src=\"https://pcngon.vn/wp-content/uploads/2025/10/May-tinh-cam-tay-AYANEO-3-R7-8840U-AI-9-HX370-5.png\" width=\"1000\"/><figcaption class=\"wp-caption-text\" id=\"caption-attachment-36364\">Máy Tính Cầm Tay Ayaneo 3 (r7 8840u, Ai 9 Hx370) 5</figcaption></figure>\n<h3><strong>Thiết kế module linh hoạt, trải nghiệm điều khiển tối ưu</strong></h3>\n<p><strong><a href=\"/danh-muc/may-choi-game-ayaneo\">Máy chơi game AYANEO</a></strong> này mang phong cách thiết kế hiện đại, với hệ thống điều khiển module có thể thay thế dễ dàng. Các cần analog Hall, trigger Hall và nút bấm ABXY được cải tiến mang đến độ chính xác cao, cảm giác bấm êm và độ bền vượt trội. Thiết kế tay cầm bo tròn vừa vặn giúp người dùng chơi lâu mà không bị mỏi, đồng thời có thể chuyển đổi linh hoạt giữa chế độ điều khiển game và thao tác như máy tính thông thường.</p>\n<figure class=\"wp-caption aligncenter\" id=\"attachment_36360\"><img alt=\"Máy Tính Cầm Tay Ayaneo 3 (r7 8840u, Ai 9 Hx370) 18\" class=\"size-full wp-image-36360\" height=\"741\" src=\"https://pcngon.vn/wp-content/uploads/2025/10/May-tinh-cam-tay-AYANEO-3-R7-8840U-AI-9-HX370-18.png\" width=\"1000\"/><figcaption class=\"wp-caption-text\" id=\"caption-attachment-36360\">Máy Tính Cầm Tay Ayaneo 3 (r7 8840u, Ai 9 Hx370) 18</figcaption></figure>\n<h3><strong>Kết nối tốc độ cao và hệ thống tản nhiệt thông minh</strong></h3>\n<p>Máy trang bị hai cổng USB4 tốc độ 40 Gbps, hỗ trợ DisplayPort 1.4 và sạc nhanh PD, cùng cổng OCuLink 64 Gbps cho khả năng kết nối eGPU mở rộng sức mạnh đồ họa. Bên cạnh đó, máy tính cầm tay AYANEO 3 hỗ trợ Wi-Fi 6E và Bluetooth 5.3 giúp duy trì kết nối ổn định. Hệ thống tản nhiệt tối ưu với ba ống dẫn nhiệt, quạt turbo và tấm đồng lớn giúp duy trì công suất ổn định 35W mà vẫn đảm bảo nhiệt độ mát mẻ khi hoạt động lâu dài.</p>\n<figure class=\"wp-caption aligncenter\" id=\"attachment_36362\"><img alt=\"Máy Tính Cầm Tay Ayaneo 3 (r7 8840u, Ai 9 Hx370) 7\" class=\"size-full wp-image-36362\" height=\"710\" src=\"https://pcngon.vn/wp-content/uploads/2025/10/May-tinh-cam-tay-AYANEO-3-R7-8840U-AI-9-HX370-7.png\" width=\"1000\"/><figcaption class=\"wp-caption-text\" id=\"caption-attachment-36362\">Máy Tính Cầm Tay Ayaneo 3 (r7 8840u, Ai 9 Hx370) 7</figcaption></figure>\n<p>Tổng thể, <strong><a href=\"/san-pham/may-tinh-cam-tay-ayaneo-3-r7-8840u-ai-9-hx370\">máy tính cầm tay AYANEO 3 (R7 8840U/AI 9 HX370)</a></strong> là lựa chọn hoàn hảo cho những ai cần một thiết bị gaming di động nhưng vẫn mạnh mẽ như máy tính để bàn.</p>","url":"https://pcngon.vn/may-tinh-cam-tay-ayaneo-3-r7-8840u-ai-9-hx370/"}