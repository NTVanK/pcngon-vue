value":"den"}],"price":0,"sku":null,"image":""},{"name":"","attributes":[{"name":"MÀU","value":"trang"}],"price":0,"sku":null,"image":""}],"specs":{},"warranty":"","html":"<h2><strong>Giới thiệu về Vỏ case máy tính Mini ITX Jonsbo T7 (Black/White)</strong></h2>\n<p><strong>Vỏ case máy tính Mini ITX Jonsbo T7 (Black/White)</strong> là lựa chọn nổi bật dành cho người dùng yêu thích phong cách thiết kế hiện đại, nhỏ gọn nhưng vẫn đầy đủ tính năng. Hãy cùng <strong><a href=\"/\">Pcngon</a></strong> tìm hiểu chi tiết hơn về sản phẩm này.</p>\n<h3><strong>Cấu trúc hai buồng đảo ngược – tối ưu luồng khí &amp; quản lý dây</strong></h3>\n<p>Jonsbo T7 sử dụng thiết kế dual‑chamber đảo ngược độc đáo, phân tách PSU vào buồng dưới và phần main/bao gồm GPU, CPU vào buồng trên. Cách bố trí này giúp không chỉ cải thiện luồng khí toàn bộ hệ thống mà còn hỗ trợ đường đi dây gọn gàng, giảm nhiệt giữ sạch bên trong.</p>\n<figure class=\"wp-caption aligncenter\" id=\"attachment_33427\"><img alt=\"Vỏ Case Máy Tính Mini Itx Jonsbo T7 (black, White) 1\" class=\"size-full wp-image-33427\" height=\"800\" src=\"https://pcngon.vn/wp-content/uploads/2025/07/Vo-case-may-tinh-Mini-ITX-Jonsbo-T7-Black-White-1.jpg\" width=\"800\"/><figcaption class=\"wp-caption-text\" id=\"caption-attachment-33427\">Vỏ Case Máy Tính Mini Itx Jonsbo T7 (black, White) 1</figcaption></figure>\n<h3><strong>Vật liệu cao cấp – nhôm dày + thép + nhấn gỗ ấn tượng</strong></h3>\n<p>Thân <strong><a href=\"/danh-muc/vo-case-mini-itx\">vỏ case Mini ITX</a></strong> này làm từ nhôm 3 mm mặt ngoài, thép 1 mm mặt trong, cùng tấm gỗ trang trí ở buồng nguồn tạo điểm nhấn tinh tế và đẳng cấp. Kết hợp kính cường lực bên hông (3 mm, có thể thay bằng panel kín) mang lại phối cảnh hiện đại và sẵn sàng để khoe phần linh kiện bên trong.</p>\n<figure class=\"wp-caption aligncenter\" id=\"attachment_33426\"><img alt=\"Vỏ Case Máy Tính Mini Itx Jonsbo T7 (black, White) 2\" class=\"size-full wp-image-33426\" height=\"800\" src=\"https://pcngon.vn/wp-content/uploads/2025/07/Vo-case-may-tinh-Mini-ITX-Jonsbo-T7-Black-White-2.jpg\" width=\"800\"/><figcaption class=\"wp-caption-text\" id=\"caption-attachment-33426\">Vỏ Case Máy Tính Mini Itx Jonsbo T7 (black, White) 2</figcaption></figure>\n<h3><strong>Hỗ trợ linh kiện mạnh – tương thích ITX &amp; mATX</strong></h3>\n<p>Kích thước 210 × 305 × 403 mm, nặng ~5,85 kg, T7 hỗ trợ cả bo mạch Mini‑ITX và Micro‑ATX, có 4 slot PCI mở rộng. Về khả năng tương thích linh kiện: tản CPU cao tối đa 165 mm, GPU dài lên đến 255–280 mm (có thể tháo quạt trước để lắp GPU dài nhất), nguồn PSU tối đa 220 mm.</p>\n<figure class=\"wp-caption aligncenter\" id=\"attachment_33405\"><img alt=\"Vỏ Case Máy Tính Mini Itx Jonsbo T7 (black, White) 23\" class=\"size-full wp-image-33405\" height=\"800\" src=\"https://pcngon.vn/wp-content/uploads/2025/07/Vo-case-may-tinh-Mini-ITX-Jonsbo-T7-Black-White-23.jpg\" width=\"800\"/><figcaption class=\"wp-caption-text\" id=\"caption-attachment-33405\">Vỏ Case Máy Tính Mini Itx Jonsbo T7 (black, White) 23</figcaption></figure>\n<h3><strong>Làm mát hiệu quả &amp; kết nối hiện đại</strong></h3>\n<p>Hệ thống quạt gồm 2 quạt 120 mm mặt trước buồng main, kèm 1 quạt 120 mm ở mặt sau giúp đẩy khí ra ngoài hiệu quả. Ngoài ra, T7 hỗ trợ khe chứa linh hoạt: 1 ổ HDD 3,5″ hoặc 2,5″ và hai khe SSD 2,5″ – phù hợp nhu cầu lưu trữ đa dạng. Cổng I/O mặt trước: USB‑C, USB‑A 3.0, jack tai nghe + mic cho tiện thiết bị ngoại vi.</p>\n<p>Tóm lại, <strong><a href=\"/san-pham/vo-case-may-tinh-mini-itx-jonsbo-t7-black-white\">vỏ case máy tính Mini ITX Jonsbo T7 (Black/White)</a></strong> là một lựa chọn cao cấp trong phân khúc mini‑tower SFF, mang lại sự cân bằng hoàn hảo giữa thiết kế nhỏ gọn, vật liệu bền đẹp, khả năng chạy mát, và linh kiện tương thích mạnh mẽ.</p>\n<p class=\"whitespace-pre-wrap break-words\">Xem thêm: <a href=\"/danh-muc/linh-kien-mini-itx\"><strong>Linh kiện Mini ITX</strong></a></p>","url":"https://pcngon.vn/vo-case-may-tinh-mini-itx-jonsbo-t7-black-white/"}